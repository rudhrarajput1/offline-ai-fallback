# Copy this file to .env (or just set these as real environment variables)
# and fill in whichever provider you're using. Never commit real keys.

# --- Gemini (default) ---
GEMINI_API_KEY=your-gemini-key-here

# --- OpenAI (optional, only if you switch ONLINE_PROVIDER to "openai") ---
OPENAI_API_KEY=your-openai-key-here

# --- Generic/custom API (optional, only if you switch ONLINE_PROVIDER to "generic") ---
CUSTOM_AI_URL=https://your-custom-api-url-here
CUSTOM_AI_API_KEY=your-custom-key-here
